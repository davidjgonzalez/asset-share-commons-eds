{
  "groups": [
    {
      "title": "Asset Share Commons - Search",
      "id": "asc-search",
      "components": [
        {
          "title": "Search Bar",
          "id": "search-bar",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Bar",
                  "model": "search-bar"
                }
              }
            }
          }
        },
        {
          "title": "Search Property Filter",
          "id": "search-property",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Property",
                  "model": "search-property",
                  "property": "jcr:content/metadata/dc:format",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Path Filter",
          "id": "search-path",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Path",
                  "model": "search-path",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Date Range Filter",
          "id": "search-date-range",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Date Range",
                  "model": "search-date-range",
                  "property": "jcr:content/metadata/dam:assetLastModified",
                  "title": ""
                }
              }
            }
          }
        },
        {
          "title": "Search Tags Filter",
          "id": "search-tags",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Tags",
                  "model": "search-tags",
                  "property": "jcr:content/metadata/cq:tags",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Statistics",
          "id": "search-statistics",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Statistics",
                  "model": "search-statistics"
                }
              }
            }
          }
        },
        {
          "title": "Search Results",
          "id": "search-results",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Results",
                  "model": "search-results",
                  "limit": "24"
                }
              }
            }
          }
        },
        {
          "title": "Search Hidden Fields",
          "id": "search-hidden",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Hidden",
                  "model": "search-hidden"
                }
              }
            }
          }
        },
        {
          "title": "Active Filters",
          "id": "search-active-filters",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Active Filters",
                  "model": "search-active-filters"
                }
              }
            }
          }
        }
      ]
    },

    {
      "title": "Asset Share Commons - Asset Details",
      "id": "asc-details",
      "components": [
        {
          "title": "Details Modal",
          "id": "details-modal",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Modal",
                  "model": "details-modal"
                }
              }
            }
          }
        },
        {
          "title": "Asset Preview",
          "id": "details-preview",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Preview",
                  "model": "details-preview"
                }
              }
            }
          }
        },
        {
          "title": "Asset Video",
          "id": "details-video",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Video",
                  "model": "details-video",
                  "height": "600px",
                  "controls": "true"
                }
              }
            }
          }
        },
        {
          "title": "Asset Property",
          "id": "details-property",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Property",
                  "model": "details-property",
                  "label": "",
                  "property": ""
                }
              }
            }
          }
        },
        {
          "title": "Asset Renditions",
          "id": "details-renditions",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Renditions",
                  "model": "details-renditions"
                }
              }
            }
          }
        },
        {
          "title": "Asset Actions",
          "id": "details-actions",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Actions",
                  "model": "details-actions"
                }
              }
            }
          }
        },
        {
          "title": "Details Header",
          "id": "details-header",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Header",
                  "model": "details-header",
                  "title": "{{title}}",
                  "meta": "{{file-type}} · {{file-size}} · {{dimensions}}"
                }
              }
            }
          }
        },
        {
          "title": "Asset Location Map",
          "id": "details-map",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Map",
                  "model": "details-map",
                  "key-value": true,
                  "latitude": "jcr:content/metadata/exif:GPSLatitude",
                  "longitude": "jcr:content/metadata/exif:GPSLongitude",
                  "altitude": "jcr:content/metadata/exif:GPSAltitude",
                  "label": "Location",
                  "zoom": "10"
                }
              }
            }
          }
        },
        {
          "title": "Similar Assets",
          "id": "details-similar",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Similar",
                  "model": "details-similar",
                  "key-value": true,
                  "description": "",
                  "max": "8",
                  "show-empty": "false"
                }
              }
            }
          }
        },
        {
          "title": "Asset Metadata (Static)",
          "id": "details-asset-metadata",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Asset Metadata",
                  "model": "details-asset-metadata"
                }
              }
            }
          }
        },
        {
          "title": "Metadata Panel",
          "id": "details-metadata",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Metadata",
                  "model": "details-metadata"
                }
              }
            }
          }
        },
        {
          "title": "Rendition Metadata",
          "id": "details-rendition-metadata",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Details Rendition Metadata",
                  "model": "details-rendition-metadata"
                }
              }
            }
          }
        }
      ]
    },

    {
