{
  "groups": [
    {
      "title": "Asset Share Commons - Search",
      "id": "asc-search",
      "components": [
        {
          "title": "Search Bar",
          "id": "search-bar",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Bar",
                  "model": "search-bar"
                }
              }
            }
          }
        },
        {
          "title": "Search Property Filter",
          "id": "search-property",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Property",
                  "model": "search-property",
                  "property": "jcr:content/metadata/dc:format",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Path Filter",
          "id": "search-path",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Path",
                  "model": "search-path",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Date Range Filter",
          "id": "search-date-range",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Date Range",
                  "model": "search-date-range",
                  "property": "jcr:content/metadata/dam:assetLastModified",
                  "title": ""
                }
              }
            }
          }
        },
        {
          "title": "Search Tags Filter",
          "id": "search-tags",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Tags",
                  "model": "search-tags",
                  "property": "jcr:content/metadata/cq:tags",
                  "title": "",
                  "type": "checkbox"
                }
              }
            }
          }
        },
        {
          "title": "Search Statistics",
          "id": "search-statistics",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Statistics",
                  "model": "search-statistics"
                }
              }
            }
          }
        },
        {
          "title": "Search Results",
          "id": "search-results",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Results",
                  "model": "search-results",
                  "limit": "24"
                }
              }
            }
          }
        },
        {
          "title": "Search Hidden Fields",
          "id": "search-hidden",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search Hidden",
                  "model": "search-hidden"
                }
              }
            }
          }
        }
      ]
    },

